@model ConfirmMailModel
@{
    ViewData["Title"] = @ViewBag.pageTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<form asp-action="Index" method="post" class="p-3 mx-auto w-75 shadow">
    <input asp-for="@Model.Email" class="form-control" type="hidden"/>
    <div class="mb-3">
        <label>@Model.Email mailinize gelen kodu giriniz:</label>
        <span class="text-danger" asp-validation-for="@Model.ConfirmCode"></span>
        <input asp-for="@Model.ConfirmCode" class="form-control" />
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Doğrula</button>
    </div>
    <div class="mb-3">
        <a asp-controller="CheckUser" asp-action="Index" class="btn btn-sm btn-secondary">Yeni Kod Gönder</a>
    </div>
    <div class="text-danger mt-4" asp-validation-summary="ModelOnly">
    </div>
</form>

