@model ForgotPasswordModel
@{
    ViewData["Title"] = @ViewBag.pageTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    @if (Model != null)
    {
        <form asp-action="Index" method="post" class="p-3 mx-auto w-75 shadow">
            <input type="hidden" asp-for="@Model.returnUrl" class="form-control" />
            <div class="mb-3">
                <label>Email:</label>
                <span class="text-danger" asp-validation-for="@Model.Email"></span>
                <input asp-for="@Model.Email" class="form-control" />
            </div>
            <div class="d-flex flex-column mb-3">
                <button type="submit" class="btn btn-primary mb-2">Bilgilerimi Gönder</button>
            </div>
            <div class="text-danger mt-4" asp-validation-summary="ModelOnly">
            </div>
        </form>
    }
    else
    {
        <p>Profil bilginiz bulunamadı.</p>
    }
}

